#!/usr/bin/env bash
# Links this repo's dotfiles into $HOME.
#
# Each layer under profiles/ mirrors $HOME: profiles/<layer>/<path> is linked
# to ~/<path>. Layers apply in order (shared, then the platform matching
# `uname -s`), and a later layer overrides an earlier one at the same path.
set -euo pipefail

usage() {
    echo "Usage: dotfiles check | dotfiles link [--dry-run]" >&2
    exit 2
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
platform=$(uname -s | tr '[:upper:]' '[:lower:]')  # darwin, linux
platform_root="$repo/profiles/platforms/$platform"
layers=("$repo/profiles/shared" "$platform_root")

check() {
    local missing=0 layer file item

    echo "Checking platform: $platform"
    echo "Commands:"
    for layer in "${layers[@]}"; do
        file="$layer/checks/commands"
        [ -f "$file" ] || continue
        # `|| [ -n ]` keeps a last line that has no trailing newline.
        while IFS= read -r item || [ -n "$item" ]; do
            # Strip comments, then trailing and leading whitespace.
            item=${item%%#*}
            item=${item%"${item##*[![:space:]]}"}
            item=${item#"${item%%[![:space:]]*}"}
            [ -n "$item" ] || continue

            if command -v "$item" >/dev/null 2>&1; then
                printf '  OK       %s\n' "$item"
            else
                printf '  MISSING  %s\n' "$item"
                missing=$((missing + 1))
            fi
        done < "$file"
    done

    echo
    if [ "$missing" -eq 0 ]; then
        echo "All requirements are installed."
    else
        echo "$missing requirement(s) missing."
        exit 1
    fi
}

# Prints the absolute path a symlink chain ends at (portable `readlink -f`).
# Fails when the final path's parent folder doesn't exist, e.g. a broken link.
resolve_path() {
    local path="$1" link directory
    while [ -L "$path" ]; do
        link=$(readlink "$path")
        if [[ "$link" = /* ]]; then
            path="$link"
        else
            path="$(dirname "$path")/$link"
        fi
    done
    directory=$(cd -P "$(dirname "$path")" 2>/dev/null && pwd) || return 1
    printf '%s/%s\n' "$directory" "$(basename "$path")"
}

# Makes sure every parent folder of a target is a real folder before linking
# into it. A parent that is a link into this repo (e.g. a whole folder linked
# by an earlier run) is replaced with an empty real folder; a parent linking
# anywhere else is never touched, and the run stops.
materialize_repo_ancestor() {
    local target="$1" relative part current="$HOME"
    relative=${target#"$HOME"/}
    [[ "$relative" == */* ]] || return 0
    IFS='/' read -r -a parts <<< "${relative%/*}"
    for part in "${parts[@]}"; do
        [ -n "$part" ] || continue
        current="$current/$part"
        if [ -L "$current" ]; then
            resolved=$(resolve_path "$current" || true)
            case "$resolved" in
                "$repo"/*)
                    echo "MATERIALIZE $current"
                    if [ "$action" = "link" ]; then
                        unlink "$current"
                        mkdir -p "$current"
                    fi
                    ;;
                *)
                    echo "Refusing to traverse non-dotfiles symlink: $current" >&2
                    exit 1
                    ;;
            esac
        elif [ "$action" = "link" ]; then
            mkdir -p "$current"
        fi
    done
}

link() {
    # Parallel arrays (bash 3.2 on macOS has no associative arrays):
    # targets[i] is a path in $HOME, sources[i] the layer entry that wins for it.
    local -a sources=() targets=()
    local layer source relative target target_index index resolved_source resolved_target
    local backup_root
    backup_root="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

    for layer in "${layers[@]}"; do
        while IFS= read -r -d '' source; do
            relative=${source#"$layer"/}
            [[ "$relative" == checks/* ]] && continue
            target="$HOME/$relative"
            target_index=-1
            for index in "${!targets[@]}"; do
                if [ "${targets[$index]}" = "$target" ]; then
                    target_index=$index
                    break
                fi
            done
            if [ "$target_index" -eq -1 ]; then
                targets+=("$target")
                sources+=("$source")
            else
                sources[$target_index]="$source"
            fi
        # find doesn't follow symlinks, so a linked folder such as
        # .config/nvim -> config/nvim is one entry, not every file inside it.
        done < <(find "$layer" -mindepth 1 \( -type f -o -type l \) -print0)
    done

    for index in "${!targets[@]}"; do
        target=${targets[$index]}
        source=${sources[$index]}
        # Links in $HOME point at the real file, not at the profiles/ entry.
        resolved_source=$(resolve_path "$source")

        materialize_repo_ancestor "$target"

        if [ -L "$target" ]; then
            # Broken links fail to resolve and fall through to RELINK.
            resolved_target=$(resolve_path "$target" || true)
            if [ "$resolved_target" = "$resolved_source" ]; then
                echo "CURRENT     $target -> $resolved_source"
                continue
            fi
            echo "RELINK      $target -> $resolved_source"
            if [ "$action" = "link" ]; then
                unlink "$target"
            fi
        elif [ -e "$target" ]; then
            relative=${target#"$HOME"/}
            echo "BACKUP      $target -> $backup_root/$relative"
            if [ "$action" = "link" ]; then
                mkdir -p "$(dirname "$backup_root/$relative")"
                mv "$target" "$backup_root/$relative"
            fi
        else
            echo "LINK        $target -> $resolved_source"
        fi

        if [ "$action" = "link" ]; then
            mkdir -p "$(dirname "$target")"
            ln -s "$resolved_source" "$target"
        fi
    done

    # Prune links into the repo that the current profiles don't produce, whether
    # their target still exists (profile entry removed) or not (content deleted).
    # Only links this script could have made qualify: absolute paths into the
    # repo. ~/Library is skipped for speed, and the repo for its own internal
    # relative links.
    local stale managed
    while IFS= read -r -d '' stale; do
        managed=false
        for target in "${targets[@]}"; do
            if [ "$target" = "$stale" ]; then
                managed=true
                break
            fi
        done
        [ "$managed" = true ] && continue
        echo "PRUNE       $stale -> $(readlink "$stale")"
        if [ "$action" = "link" ]; then
            unlink "$stale"
        fi
    done < <(find "$HOME" -maxdepth 4 \( -path "$HOME/Library" -o -path "$repo" \) -prune \
        -o -type l -lname "$repo/*" -print0 2>/dev/null)
}

case "${1:-}" in
    check)
        [ "$#" -eq 1 ] || usage
        ;;
    link)
        if [ "$#" -eq 1 ]; then
            action=link
        elif [ "$#" -eq 2 ] && [ "$2" = "--dry-run" ]; then
            action=plan
        else
            usage
        fi
        ;;
    *)
        usage
        ;;
esac

[ -d "$platform_root" ] || {
    echo "No matching platform profile found for: $platform" >&2
    exit 1
}

"$1"
