#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if [ $# -gt 0 ]; then
	echo 'usage: pasta (takes no arguments)' >&2
	exit 2
fi

if hash pbpaste 2>/dev/null; then
	exec pbpaste
elif [ -n "${DISPLAY:-}" ] && hash xclip 2>/dev/null; then
	exec xclip -selection clipboard -o
elif [ -n "${DISPLAY:-}" ] && hash xsel 2>/dev/null; then
	exec xsel --clipboard --output
fi

file=${XDG_STATE_HOME:-$HOME/.local/state}/clipboard
if [ ! -f "$file" ]; then
	echo 'pasta: no saved clipboard; send some text to copy first' >&2
	exit 1
fi
exec cat "$file"
