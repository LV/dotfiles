#!/usr/bin/env bash
set -e
set -u
set -o pipefail

# Usage forms for `copy`:
#
#   cat foo.bar | copy
#       Pipe a file's contents in (the classic case).
#
#   some_command | copy
#       Pipe the output of any command, e.g.:
#         git diff | copy
#         ls -la | copy
#         echo "hello" | copy
#
#   copy < foo.bar
#       Redirect a file in directly, no cat needed.
#
#   copy <<< "$some_var"
#       Here-string: copy the contents of a variable.
#
#   copy <<'EOF'
#   multi
#   line
#   text
#   EOF
#       Heredoc: copy a literal multi-line block.
#
#   result=$(some_command); echo "$result" | copy
#       Capture a command's output in a variable first
#       (useful if you want to reuse/print it too), then copy it.
#
#   some_command | tee /dev/tty | copy
#       See the output in your terminal AND copy it at the same time,
#       instead of just piping blindly.
#
#   !! | copy
#       Re-run your last command and copy its output
#       (bash history expansion — only works if it's safe/cheap to re-run).
#
# Note: `copy foo.bar` (passing a filename as an argument) is rejected —
# this script only reads from stdin.
#
# Without a usable local clipboard (headless, SSH), the text is saved to
# ${XDG_STATE_HOME:-~/.local/state}/clipboard for `pasta`, and sent to the
# terminal as OSC 52 so it lands in the local clipboard.

if [ $# -gt 0 ]; then
	echo 'usage: copy < input (reads stdin only)' >&2
	exit 2
fi

contents=$(cat)

cmd=''
if hash pbcopy 2>/dev/null; then
	cmd='pbcopy'
elif hash clip.exe 2>/dev/null; then
	cmd='clip.exe'
elif [ -n "${DISPLAY:-}" ] && hash xclip 2>/dev/null; then
	cmd='xclip -selection clipboard'
elif [ -n "${DISPLAY:-}" ] && hash xsel 2>/dev/null; then
	cmd='xsel --clipboard --input'
fi

if [ -n "$cmd" ]; then
	printf '%s' "$contents" | $cmd
	exit 0
fi

umask 077
dir=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$dir"
tmp=''
trap 'rm -f "$tmp"' EXIT
tmp=$(mktemp "$dir/.clipboard.XXXXXX")
printf '%s' "$contents" >"$tmp"
mv -f "$tmp" "$dir/clipboard"

case ${TERM:-} in
linux | dumb | '') exit 0 ;;
esac

# No controlling terminal (e.g. run by Neovim, which sends its own OSC 52): skip.
if { exec 3>/dev/tty; } 2>/dev/null; then
	printf '\033]52;c;%s\a' "$(printf '%s' "$contents" | base64 | tr -d '\n')" >&3
fi
